#!/bin/sh
# Maven Wrapper script
# Downloads Maven if not present and runs it

set -e

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
    DIST_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

DIST_URL="${DIST_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip}"
MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.6"

if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
    echo "Downloading Maven 3.9.6..."
    mkdir -p "$MAVEN_HOME"
    TMPFILE=$(mktemp /tmp/maven-XXXXXX.zip)
    curl -sSL "$DIST_URL" -o "$TMPFILE"
    unzip -q -o "$TMPFILE" -d "$HOME/.m2/wrapper/dists/"
    rm -f "$TMPFILE"
    # The zip extracts to apache-maven-3.9.6/
    if [ -d "$HOME/.m2/wrapper/dists/apache-maven-3.9.6" ]; then
        MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.6"
    fi
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
